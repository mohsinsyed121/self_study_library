# Copy this file to .env and fill in your own values. NEVER commit .env.
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Needed in production, e.g. https://your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave empty to use local SQLite. On Render this is filled from your PostgreSQL database.
DATABASE_URL=
